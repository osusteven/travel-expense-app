rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(tripId) {
      return request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    match /trips/{tripId} {
      // The trip ID is a random 20-character code and acts as the invite:
      // whoever has it can look the trip up and join it.
      allow get: if signedIn();
      // Listing only returns trips you belong to.
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      // The creator is the only initial member.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        // Members can edit the trip but not change who belongs to it...
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        // ...and anyone with the code can add themselves (and only themselves).
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid]))
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /expenses/{expenseId} {
        allow read, write: if signedIn() && isMemberOf(tripId);
      }
    }
  }
}
