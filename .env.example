# Shared password to open the app (case-insensitive).
APP_PASSWORD=Steven

# Names shown in the app.
PERSON_1_NAME=Steven
PERSON_2_NAME=Partner

# Currency all balances are settled in. Don't change it after you've added entries.
HOME_CURRENCY=USD

# Local development uses a SQLite file. In production use a hosted libSQL database (e.g. Turso):
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:data/ledger.db
