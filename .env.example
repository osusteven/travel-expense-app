# Shared password to open the app (case-insensitive).
APP_PASSWORD=Steven

# Names shown in the app.
PERSON_1_NAME=Steven
PERSON_2_NAME=Partner

# Currency all balances are settled in. Don't change it after you've added entries.
HOME_CURRENCY=USD

# Postgres connection string. Vercel sets this automatically when you add a Neon database from the
# Storage tab; `vercel env pull .env.local` copies it for local development.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
